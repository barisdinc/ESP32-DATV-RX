+
+def cs4_gain(shift_word):
+    """The gain g of a cs4 packet from header word 8: sample (cs16 units) = (v + 0.5) / g."""
+    gb = shift_word >> 8
+    return CS4_MANT[(gb >> 4) & 7] / float(1 << (8 + (gb & 15)))
+
+
+def unpack_cs4(payload, shift_word, np):
+    """cs4 payload -> interleaved float32 I, Q in cs16 units."""
+    b = np.frombuffer(payload, dtype=np.uint8)
+    v = np.empty(2 * len(b), dtype=np.int8)
+    v[0::2] = (b << 4).astype(np.int8) >> 4  # I: bits 0..3, sign-extended
+    v[1::2] = b.astype(np.int8) >> 4         # Q: bits 4..7
+    return (v.astype(np.float32) + 0.5) / cs4_gain(shift_word)
